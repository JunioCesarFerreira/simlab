# SimLab deployment settings.
#
#   cp .env.example .env
#
# Every variable below has a working default baked into docker-compose.yaml, so
# the stack comes up without a .env file. Create one to publish SimLab under a
# real hostname, on different ports, or with credentials of your own.

# --- Reverse proxy ----------------------------------------------------------

# Public base URL clients type into the browser. It drives the HTTP -> HTTPS
# redirect and Grafana's root_url, so it must include the published HTTPS port
# whenever that is not 443:
#   SIMLAB_PUBLIC_URL=https://simlab.example.org
#   SIMLAB_PUBLIC_URL=https://simlab.example.org:8443
SIMLAB_PUBLIC_URL=https://localhost

# Host ports published by the proxy - the only ports the stack exposes off-box.
SIMLAB_HTTP_PORT=80
SIMLAB_HTTPS_PORT=443

# --- TLS certificate --------------------------------------------------------
#
# Used only when nginx/certs/simlab.crt is missing: the proxy-certs init
# container generates a self-signed pair from these values on first start. To
# install a CA-issued certificate instead, copy it to nginx/certs/simlab.crt
# and nginx/certs/simlab.key and these are ignored.
SIMLAB_TLS_CN=localhost
SIMLAB_TLS_SAN=DNS:localhost,IP:127.0.0.1
SIMLAB_TLS_DAYS=825

# --- Credentials ------------------------------------------------------------
#
# Change both before exposing SimLab to anything but localhost.
#
# Note: SIMLAB_API_KEY is also baked into the SPA bundle at build time, so
# changing it requires `docker compose up -d --build gui`.
SIMLAB_API_KEY=simlab-api-key42
GRAFANA_ADMIN_USER=simlab
GRAFANA_ADMIN_PASSWORD=simlab123
